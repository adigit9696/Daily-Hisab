rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy paths
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }
    match /days/{date} {
      allow read, write: if request.auth != null;
    }
    // Shared shop data — all devices sync together
    match /shops/{shopId}/data/{docId} {
      allow read, write: if request.auth != null;
    }
    match /shops/{shopId}/days/{date} {
      allow read, write: if request.auth != null;
    }
  }
}
